# cricAI LAN deployment environment (US-L3: LAN-local, no cloud egress).
#
# Copy to deploy/.env, fill in every empty value, and NEVER commit the copy.
# The same file feeds BOTH deployment paths (docs/runbooks/deploy_lan.md):
#   - compose path:  docker compose reads deploy/.env automatically (the
#     compose project directory is deploy/).
#   - process path:  scripts/deploy_local.sh sources it before starting
#     uvicorn + the rq worker + next start.
#
# Generate tokens with:  openssl rand -hex 32

# --- Role tokens (US-L3). An empty token means that role CANNOT log in. ---
# The parent token is the admin credential; verify_deploy.py requires it.
CRICAI_PARENT_TOKEN=
CRICAI_COACH_TOKEN=
CRICAI_PLAYER_TOKEN=

# --- PostgreSQL (compose path creates the cluster from these). ---
# Set a STRONG password (`openssl rand -hex 24`) — this DB is on the LAN and
# the tokens above are not the only credential worth protecting. Leaving it
# empty fails compose interpolation loudly (":?" form); the process path
# warns loudly about the weak cricai:cricai fallback and proceeds (deploy_local.sh).
CRICAI_POSTGRES_USER=cricai
CRICAI_POSTGRES_PASSWORD=
CRICAI_POSTGRES_DB=cricai

# --- Database URL (process path: API, worker, alembic migrations). ---
# The compose path IGNORES this and derives the in-network URL
# (postgresql+psycopg://user:pass@postgres:5432/db) from the three values
# above. For the process path, point at your existing local PostgreSQL 16 and
# put the REAL role password here (it must match what you set on the role;
# see the runbook §2). Do not ship the placeholder below to production.
CRICAI_DATABASE_URL=postgresql+psycopg://cricai:REPLACE_WITH_DB_PASSWORD@localhost:5432/cricai

# --- Redis (RQ job queue). Compose ignores this (uses redis://redis:6379/0). ---
CRICAI_REDIS_URL=redis://localhost:6379/0

# RQ queue the worker listens on (deployment convention; jobs enqueued via
# cricai_worker.pipeline.enqueue_session_pipeline land here).
CRICAI_RQ_QUEUE=cricai

# --- Object storage root (per-session media, clips, backups manifests). ---
# Process path: a directory on the lab box. Compose path ignores this and
# mounts the cricai-storage named volume at /data/storage in api + worker.
CRICAI_STORAGE_ROOT=storage

# --- Pose model asset (OPTIONAL; US-E1..E4 pose stage). ---
# Filesystem path to a MediaPipe pose-landmarker `.task` bundle, read by the
# pipeline's pose stage (apps/worker stage_adapters.resolve_pose_provider).
# LEAVE EMPTY to run the deterministic FakePoseProvider: analysis still runs
# and reports still generate, but on SEEDED SYNTHETIC skeletons, not the real
# footage — the fallback is stamped onto every pose_tracks row (model_name),
# so it is visible in the data, never silent. Set it (and install the `pose`
# extra) for real pose tracking. Compose path: this is the path AS SEEN BY
# THE CONTAINER (repo mounted at /app), so a repo-relative asset works.
CRICAI_POSE_MODEL_ASSET=

# --- Host ports. ---
CRICAI_API_PORT=8000
CRICAI_WEB_PORT=3000

# --- Web dashboard build-time variables (BUILD-TIME INLINING CAVEAT). ---
# Next.js inlines NEXT_PUBLIC_* into the JS bundle at `pnpm build` time:
# changing any of them requires a REBUILD (process path: rebuild apps/web;
# compose path: the web container rebuilds on every container start, so
# `docker compose up -d --force-recreate web` picks up new values).
# Use the LAN address of the lab box, NOT localhost, so other devices work.
NEXT_PUBLIC_API_BASE_URL=http://lab.local:8000
# Bearer token the dashboard sends. NEXT_PUBLIC_* is INLINED into the JS
# bundle at build time, so this token is served to — and trivially
# extractable by — every browser (any device) that loads the dashboard.
# Use the LEAST-PRIVILEGED role that the shared dashboard needs: the PLAYER
# token (CRICAI_PLAYER_TOKEN), NOT the parent/coach admin tokens. Build a
# separate dashboard with a higher-privilege token only for a trusted device
# that never leaves parent/coach hands (see apps/web/README.md and runbook §2).
NEXT_PUBLIC_API_TOKEN=
# Base URL where the object-store tree is served over HTTP for clip playback
# (MinIO or any static file server over CRICAI_STORAGE_ROOT — not part of
# the five compose services; see the runbook's media-serving note).
NEXT_PUBLIC_CRICAI_MEDIA_BASE=http://lab.local:9000/cricai
